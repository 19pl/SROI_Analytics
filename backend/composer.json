  "type": "project",
  "license": "ISC",
  "require": { "php": ">=8.1", "ext-pdo_sqlite": "*", "ext-mbstring": "*", "ext-iconv": "*", "ext-fileinfo": "*" },
  "autoload": { "psr-4": { "App\\": "src/" } },
  "scripts": {
    "migrate": "php bin/migrate.php",
