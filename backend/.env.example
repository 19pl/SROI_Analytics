# Copy to .env (never commit .env)
APP_DEBUG=false
DB_PATH=storage/sroi.sqlite
STORAGE_PATH=storage
TOKEN_TTL_DAYS=30
MAX_UPLOAD_MB=10
# Comma-separated origins of the separately-hosted frontend (use * only if you accept any origin; auth is by bearer token, not cookies)
CORS_ALLOWED_ORIGINS=http://localhost:3000,app://sroi
# Optional: public frontend URL prefix for shared report links, e.g. https://app.example.org/r
PUBLIC_REPORT_BASE_URL=
